{
  "compilerOptions": {
    "lib": ["ES2017"],
    "target": "ES2017",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "allowJs": true,
    "strictPropertyInitialization": false,
    "baseUrl": "./src/",
    "outDir": "./dist",
    "moduleResolution": "Node",
    "paths": {
      "@esync/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
