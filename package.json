{
  "name": "extensions-sync",
  "version": "0.1.0",
  "author": "Richard Paul <rnpdevcontact@gmail.com>",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "npm run build:ts && npm run build:extension",
    "build:extension": "npm run build:schema && npm run build:locales",
    "build:locales": "node scripts/build-locales.mjs",
    "build:package": "npm run build && rm -rf './dist/extensions-sync@richardnpaul.github.com.zip' && cd ./dist && zip -qr 'extensions-sync@richardnpaul.github.com.zip' .",
    "build:schema": "npm run clean:schema && glib-compile-schemas ./resources/schemas --targetdir=./dist/schemas/",
    "build:ts": "npm run clean:ts && rollup -c",
    "checksums": "cd dist && sha256sum extensions-sync@richardnpaul.github.com.zip extensions-sync@richardnpaul.github.com.sbom.json > checksums.txt",
    "clean": "npm run clean:ts && npm run clean:reports",
    "clean:ts": "rm -rf ./dist",
    "clean:reports": "rm -rf ./coverage ./reports stryker-setup-*.js",
    "clean:schema": "rm -rf ./dist/schemas/*.compiled",
    "lint": "eslint --ext .ts src/",
    "prefs": "GI_TYPELIB_PATH=/usr/lib/gnome-shell/girepository-1.0:$GI_TYPELIB_PATH gjs -m scripts/test-prefs.js",
    "prefs:screenshots": "xvfb-run -a env GSETTINGS_BACKEND=memory GI_TYPELIB_PATH=/usr/lib/gnome-shell/girepository-1.0:$GI_TYPELIB_PATH gjs -m scripts/generate-preferences-screenshots.js",
    "sbom": "mkdir -p dist && npm sbom --sbom-format cyclonedx > dist/extensions-sync@richardnpaul.github.com.sbom.json",
    "test": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:nested": "dbus-run-session -- gnome-shell --devkit",
    "test:prefs": "xvfb-run -a npm run prefs -- --check",
    "test:prefs:rtl": "xvfb-run -a npm run prefs -- --check --rtl",
    "test:watch": "vitest",
    "translations:extract": "xgettext --from-code=UTF-8 --output=po/extensions-sync@richardnpaul.github.com.pot --package-name=\"Extensions Sync\" --package-version=\"1\" --msgid-bugs-address=\"https://github.com/richardnpaul/gnome-shell-extensions-sync/issues\" --keyword=_ --language=JavaScript src/panel/statusMenu.ts src/prefs/prefs.ts src/sync/index.ts src/api/index.ts src/api/providers/github.ts src/api/providers/gitlab.ts src/api/providers/local.ts",
    "typecheck": "tsc --noEmit",
    "watch": "npm run build && rollup -c --watch"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@gi-types/gdk4": "^4.0.1",
    "@gi-types/gdkpixbuf2": "^2.0.2",
    "@gi-types/gio2": "^2.72.1",
    "@gi-types/glib2": "^2.72.1",
    "@gi-types/gobject2": "^2.72.1",
    "@gi-types/gtk4": "^4.6.1",
    "@gi-types/meta10": "^10.0.1",
    "@gi-types/shell0": "^0.1.1",
    "@gi-types/soup3": "^3.0.1",
    "@gi-types/st1": "^1.0.1",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/events": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "3.2.7",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "rollup": "^4.34.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^7.3.7",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "events": "^3.3.0",
    "fast-xml-parser": "^5.11.2"
  }
}
