msgstr "Izilungiselelo zilondolozwe ngempumelelo ku-%s"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Kuvele iphutha ngenkathi kulondolozwa izilungiselelo ku-%s. Sicela uhlole izingodo."

