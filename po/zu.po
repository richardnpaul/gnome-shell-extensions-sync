msgstr "Kwehlulekile ukusebenzisa idatha yokuvumelanisa kusistimu yamanje."

#: src/sync/index.ts:47
msgid "Extensions are updated. Reloading Gnome Shell"
msgstr "Izandiso zibuyekeziwe. Iyalayisha kabusha i-GNOME Shell"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Izandiso zibuyekeziwe. Sicela ulayishe kabusha i-GNOME Shell"

#: src/api/index.ts:47
msgid "Could not save"
msgstr "Could not save"

#: src/api/index.ts:51
