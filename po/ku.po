msgid "Sync Provider"
msgstr "Pêşkêşkerê Hevdengkirinê"

#: src/prefs/prefs.ts:22
msgid "Select the cloud or local service to sync your settings with."
msgstr "Ji bo hevdengkirina mîhengên xwe servîsa ewr an herêmî hilbijêre."

