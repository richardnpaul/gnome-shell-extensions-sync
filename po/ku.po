msgid "GitLab Settings"
msgstr "Mîhengên GitLab"

#: src/prefs/prefs.ts:67
msgid "Create a private snippet on gitlab.com and generate an access token."
msgstr "Li ser gitlab.com perçeyek taybet çêbikin û nîşanek gihîştinê biafirînin."

#: src/prefs/prefs.ts:70
msgid "Snippet ID"
msgstr "Nasnameya Perçeyê"

#: src/prefs/prefs.ts:79
msgid "GitLab Token"
msgstr "Tokena GitLab"

#: src/prefs/prefs.ts:90
msgid "Local Backup Settings"
msgstr "Mîhengên Piştgiriya Herêmî"

#: src/prefs/prefs.ts:91
msgid "Save and restore your configuration to/from a local JSON file."
msgstr "Veavakirina xwe di pelek JSON a herêmî de tomar bikin û sererast bikin."

#: src/prefs/prefs.ts:96
msgid "Backup File Location"
msgstr "Cihê Pela Piştgiriyê"

#: src/prefs/prefs.ts:97
msgid "No file selected"
msgstr "Pel nehatiye hilbijartin"

#: src/prefs/prefs.ts:101
msgid "Browse…"
msgstr "Bigere…"

#: src/prefs/prefs.ts:107
msgid "Select Backup File Location"
msgstr "Cihê Pela Piştgiriyê Hilbijêre"

#: src/prefs/prefs.ts:111
msgid "JSON files (*.json)"
msgstr "JSON files (*.json)"

#: src/prefs/prefs.ts:157
msgid "Synced Data"
msgstr "Daneyên Hevdengkirî"

#: src/prefs/prefs.ts:162
msgid "Synchronized Components"
msgstr "Parçeyên Hevdengkirî"

#: src/prefs/prefs.ts:163
msgid "Choose which components will be uploaded and downloaded."
msgstr "Hilbijêre ka kîjan beş werin barkirin û daxistin."

#: src/prefs/prefs.ts:169
msgid "Extensions"
msgstr "Pêvek"

#: src/prefs/prefs.ts:170
msgid "Sync all user extensions and their dconf configurations"
msgstr "Hemî pêvekên bikarhêner û mîhengên dconf hevdeng bike"

#: src/prefs/prefs.ts:174
msgid "Keybindings"
msgstr "Kurteriyên Klavyeyê"

#: src/prefs/prefs.ts:175
msgid "Sync all GNOME Shell and GTK window/media keybindings"
msgstr "Hemî kurteriyên GNOME Shell û GTK hevdeng bike"

#: src/prefs/prefs.ts:179
msgid "Tweaks"
msgstr "Verastkirin"

#: src/prefs/prefs.ts:180
msgid "Sync GNOME desktop theme, font, interface and tweak settings"
msgstr "Mijar, tîp û verastkirinên sermaseya GNOME hevdeng bike"

#: src/prefs/prefs.ts:212
msgid "General"
msgstr "Giştî"

#: src/prefs/prefs.ts:217
msgid "Behavior and Interface"
msgstr "Tevger û Rûkar"

#: src/prefs/prefs.ts:221
msgid "Show Tray Icon"
msgstr "Sembola di qada ragihandinê de nîşan bide"

#: src/prefs/prefs.ts:222
msgid "Display the sync status icon in the top panel"
msgstr "Sembola rewşa hevdengkirinê li panela jor nîşan bide"

#: src/prefs/prefs.ts:228
msgid "Show Notifications"
msgstr "Agahdariyan nîşan bide"

#: src/prefs/prefs.ts:229
msgid "Display desktop notifications on sync progress and errors"
msgstr "Agahdariyên sermaseyê li ser pêşveçûn û çewtiyan nîşan bide"

#: src/sync/index.ts:42
msgid "Failed to apply sync data to current system."
msgstr "Daneyên hevdengkirinê li pergala heyî nehatin sepandin."

#: src/sync/index.ts:47
msgid "Extensions are updated. Reloading Gnome Shell"
msgstr "Pêvek hatin nûvekirin. GNOME Shell ji nû ve tê barkirin"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Pêvek hatin nûvekirin. Ji kerema xwe GNOME Shell ji nû ve bar bike"

#: src/api/index.ts:47
msgid "Could not save"
msgstr "Could not save"

#: src/api/index.ts:51
#, javascript-format
msgid "Settings successfully saved to %s"
msgstr "Mîheng bi serkeftî li %s hatin tomarkirin"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Dema tomarkirina mîhengan li %s çewtî derket. Ji kerema xwe rojaneyan kontrol bikin."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Dema xwendina mîhengan ji %s çewtî derket. Ji kerema xwe rojaneyan kontrol bikin."

#: src/api/providers/github.ts:50 src/api/providers/gitlab.ts:39
#, javascript-format
msgid "failed to save data to %s. Server status: %s"
msgstr "failed to save data to %s. Server status: %s"

#: src/api/providers/github.ts:69 src/api/providers/gitlab.ts:58
#, javascript-format
msgid "failed to read data from %s. Server status: %s"
msgstr "failed to read data from %s. Server status: %s"

#: src/api/providers/github.ts:74 src/api/providers/gitlab.ts:63
#, javascript-format
msgid "failed to read data from %s. Empty response"
msgstr "failed to read data from %s. Empty response"

