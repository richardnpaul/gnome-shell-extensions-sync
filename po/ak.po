#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Mfomso bi sii bere a na wɔresie nhyehyɛe no wɔ %s. Yɛsrɛ wo hwɛ kyerɛwtohɔ no."

