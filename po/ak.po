#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Mfomso bi sii bere a na wɔrekenkan nhyehyɛe no firi %s. Yɛsrɛ wo hwɛ kyerɛwtohɔ no."

