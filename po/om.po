msgstr "Qindaa'inoonni milkaa'inaan gara %s tti olkaa'amaniiru"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Qindaa'inoota gara %s olkaawuu irratti dogoggorri uumameera. Galmee sakatta'aa."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Qindaa'inoota %s irraa dubbisuu irratti dogoggorri uumameera. Galmee sakatta'aa."

