msgstr "Qaxxaamura GNOME Shell fi GTK hundaa walsimsiisi"

#: src/prefs/prefs.ts:179
msgid "Tweaks"
msgstr "Sirreeffamoota"

#: src/prefs/prefs.ts:180
msgid "Sync GNOME desktop theme, font, interface and tweak settings"
msgstr "Dhaamsaa, boca qubee fi sirreeffamoota GNOME walsimsiisi"

#: src/prefs/prefs.ts:212
msgid "General"
msgstr "Waliigala"

#: src/prefs/prefs.ts:217
msgid "Behavior and Interface"
msgstr "Amala fi Fuula"

