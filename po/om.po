msgstr "Dheerisuuwwan haaromfamaniiru. GNOME Shell irra-deebiin fe'amaa jira"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Dheerisuuwwan haaromfamaniiru. Maaloo GNOME Shell irra-deebiin fe'aa"

#: src/api/index.ts:47
msgid "Could not save"
msgstr "Could not save"

#: src/api/index.ts:51
#, javascript-format
