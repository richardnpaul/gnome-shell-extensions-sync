#: src/prefs/prefs.ts:21
msgid "Sync Provider"
msgstr "Dostawca synchronizacji"

#: src/prefs/prefs.ts:22
msgid "Select the cloud or local service to sync your settings with."
msgstr "Wybierz usługę w chmurze lub lokalną do synchronizacji ustawień."

#: src/prefs/prefs.ts:30
msgid "GitHub"
msgstr "GitHub"

#: src/prefs/prefs.ts:30
msgid "GitLab"
msgstr "GitLab"

#: src/prefs/prefs.ts:30
msgid "Local"
msgstr "Lokalnie"

#: src/prefs/prefs.ts:42
msgid "GitHub Settings"
msgstr "Ustawienia GitHub"

#: src/prefs/prefs.ts:43
msgid "Create a secret Gist on gist.github.com and generate a personal access token."
msgstr "Utwórz tajny Gist w gist.github.com i wygeneruj osobisty token dostępu."

#: src/prefs/prefs.ts:46
msgid "Gist ID"
msgstr "ID Gista"

#: src/prefs/prefs.ts:55
msgid "GitHub Token"
msgstr "Token GitHub"

#: src/prefs/prefs.ts:66
msgid "GitLab Settings"
msgstr "Ustawienia GitLab"

#: src/prefs/prefs.ts:67
msgid "Create a private snippet on gitlab.com and generate an access token."
msgstr "Utwórz prywatną wstawkę w gitlab.com i wygeneruj token dostępu."

#: src/prefs/prefs.ts:70
msgid "Snippet ID"
msgstr "ID wstawki"

#: src/prefs/prefs.ts:79
msgid "GitLab Token"
msgstr "Token GitLab"

#: src/prefs/prefs.ts:90
msgid "Local Backup Settings"
msgstr "Ustawienia lokalnej kopii zapasowej"

#: src/prefs/prefs.ts:91
msgid "Save and restore your configuration to/from a local JSON file."
msgstr "Zapisuj i przywracaj konfigurację z lokalnego pliku JSON."

#: src/prefs/prefs.ts:96
msgid "Backup File Location"
msgstr "Lokalizacja pliku kopii zapasowej"

#: src/prefs/prefs.ts:97
msgid "No file selected"
msgstr "Nie wybrano pliku"

#: src/prefs/prefs.ts:101
msgid "Browse…"
msgstr "Przeglądaj…"

#: src/prefs/prefs.ts:107
msgid "Select Backup File Location"
msgstr "Wybierz lokalizację pliku kopii zapasowej"

#: src/prefs/prefs.ts:157
msgid "Synced Data"
msgstr "Synchronizowane dane"

#: src/prefs/prefs.ts:162
msgid "Synchronized Components"
msgstr "Synchronizowane składniki"

#: src/prefs/prefs.ts:163
msgid "Choose which components will be uploaded and downloaded."
msgstr "Wybierz składniki do wysyłania i pobierania."

#: src/prefs/prefs.ts:169
msgid "Extensions"
msgstr "Rozszerzenia"

#: src/prefs/prefs.ts:170
msgid "Sync all user extensions and their dconf configurations"
msgstr "Synchronizuj wszystkie rozszerzenia użytkownika i ich konfiguracje dconf"

#: src/prefs/prefs.ts:174
msgid "Keybindings"
msgstr "Skróty klawiszowe"

#: src/prefs/prefs.ts:175
msgid "Sync all GNOME Shell and GTK window/media keybindings"
msgstr "Synchronizuj wszystkie skróty okien i multimediów GNOME Shell i GTK"

#: src/prefs/prefs.ts:179
msgid "Tweaks"
msgstr "Dostrajanie"

#: src/prefs/prefs.ts:180
msgid "Sync GNOME desktop theme, font, interface and tweak settings"
msgstr "Synchronizuj motyw pulpitu, czcionki, interfejs i ustawienia dostrajania GNOME"

#: src/prefs/prefs.ts:212
msgid "General"
msgstr "Ogólne"

#: src/prefs/prefs.ts:217
msgid "Behavior and Interface"
msgstr "Zachowanie i interfejs"

#: src/prefs/prefs.ts:221
msgid "Show Tray Icon"
msgstr "Pokaż ikonę w zasobniku"

#: src/prefs/prefs.ts:222
msgid "Display the sync status icon in the top panel"
msgstr "Wyświetlaj ikonę stanu synchronizacji na górnym pasku"

#: src/prefs/prefs.ts:228
msgid "Show Notifications"
msgstr "Wyświetlaj powiadomienia"

#: src/prefs/prefs.ts:229
msgid "Display desktop notifications on sync progress and errors"
msgstr "Wyświetlaj powiadomienia pulpitu o postępie i błędach synchronizacji"

#: src/sync/index.ts:42
msgid "Failed to apply sync data to current system."
msgstr "Nie udało się zastosować danych synchronizacji w bieżącym systemie."

#: src/sync/index.ts:47
msgid "Extensions are updated. Reloading Gnome Shell"
msgstr "Rozszerzenia zostały zaktualizowane. Ponowne uruchamianie GNOME Shell"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Rozszerzenia zostały zaktualizowane. Uruchom ponownie GNOME Shell"

#: src/api/index.ts:51
#, javascript-format
msgid "Settings successfully saved to %s"
msgstr "Ustawienia pomyślnie zapisano w %s"

#: src/api/index.ts:54
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Wystąpił błąd podczas zapisywania ustawień w %s. Sprawdź dzienniki."

#: src/api/index.ts:67
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Wystąpił błąd podczas odczytywania ustawień z %s. Sprawdź dzienniki."
