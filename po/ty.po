#: src/prefs/prefs.ts:22
msgid "Select the cloud or local service to sync your settings with."
msgstr "Mā'iti i te ata 'aore rā te tōro'a 'ōire nō te fa'a'āpiti i tā 'oe nā fa'anahora'a."

#: src/prefs/prefs.ts:30
msgid "GitHub"
