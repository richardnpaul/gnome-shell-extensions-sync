#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Pantaymi karqan allichaykunata %s k'itiman waqaychachkaspa. Qhaway willaykunata."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Pantaymi karqan allichaykunata %s k'itimanta ñawinchachkaspa. Qhaway willaykunata."

