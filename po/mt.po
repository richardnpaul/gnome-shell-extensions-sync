msgstr "Sar żball waqt li kienu qed jiġu salvati s-settings f'%s. Jekk jogħġbok iċċekkja l-logs."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Sar żball waqt li kienu qed jinqraw is-settings minn %s. Jekk jogħġbok iċċekkja l-logs."

