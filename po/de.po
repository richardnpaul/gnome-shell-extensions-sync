msgid "Backup File Location"
msgstr "Sicherungsdatei-Speicherort"

#: src/prefs/prefs.ts:97
msgid "No file selected"
msgstr "Keine Datei ausgewählt"

#: src/prefs/prefs.ts:101
msgid "Browse…"
msgstr "Durchsuchen…"

#: src/prefs/prefs.ts:107
msgid "Select Backup File Location"
msgstr "Speicherort der Sicherungsdatei auswählen"

#: src/prefs/prefs.ts:157
msgid "Synced Data"
msgstr "Synchronisierte Daten"

