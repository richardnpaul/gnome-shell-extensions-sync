#: src/prefs/prefs.ts:79
msgid "GitLab Token"
msgstr "GitLab-Token"

#: src/prefs/prefs.ts:90
msgid "Local Backup Settings"
msgstr "Lokale Sicherungseinstellungen"

#: src/prefs/prefs.ts:91
msgid "Save and restore your configuration to/from a local JSON file."
msgstr "Speichern und stellen Sie Ihre Konfiguration aus einer lokalen JSON-Datei wieder her."

