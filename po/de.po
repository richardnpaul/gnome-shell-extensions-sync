msgid "Synchronized Components"
msgstr "Synchronisierte Komponenten"

#: src/prefs/prefs.ts:163
msgid "Choose which components will be uploaded and downloaded."
msgstr "Wählen Sie, welche Komponenten hoch- und heruntergeladen werden sollen."

#: src/prefs/prefs.ts:169
msgid "Extensions"
msgstr "Erweiterungen"

#: src/prefs/prefs.ts:170
msgid "Sync all user extensions and their dconf configurations"
msgstr "Alle Benutzererweiterungen und deren dconf-Einstellungen synchronisieren"

#: src/prefs/prefs.ts:174
msgid "Keybindings"
msgstr "Tastaturkürzel"

#: src/prefs/prefs.ts:175
msgid "Sync all GNOME Shell and GTK window/media keybindings"
msgstr "Alle GNOME-Shell- und GTK-Fenster-/Medientastaturkürzel synchronisieren"

#: src/prefs/prefs.ts:179
msgid "Tweaks"
msgstr "Optimierungen"

#: src/prefs/prefs.ts:180
msgid "Sync GNOME desktop theme, font, interface and tweak settings"
msgstr "GNOME-Desktop-Designs, Schriften, Oberflächen- und Optimierungseinstellungen synchronisieren"

#: src/prefs/prefs.ts:212
msgid "General"
msgstr "Allgemein"

#: src/prefs/prefs.ts:217
msgid "Behavior and Interface"
msgstr "Verhalten und Oberfläche"

#: src/prefs/prefs.ts:221
msgid "Show Tray Icon"
msgstr "Status-Symbol anzeigen"

#: src/prefs/prefs.ts:222
msgid "Display the sync status icon in the top panel"
msgstr "Das Synchronisationsstatus-Symbol im oberen Panel anzeigen"

#: src/prefs/prefs.ts:228
msgid "Show Notifications"
msgstr "Benachrichtigungen anzeigen"

#: src/prefs/prefs.ts:229
msgid "Display desktop notifications on sync progress and errors"
msgstr "Desktop-Benachrichtigungen über Synchronisationsfortschritt und Fehler anzeigen"

#: src/sync/index.ts:42
msgid "Failed to apply sync data to current system."
msgstr "Synchronisationsdaten konnten nicht auf das aktuelle System angewendet werden."

#: src/sync/index.ts:47
msgid "Extensions are updated. Reloading Gnome Shell"
msgstr "Erweiterungen wurden aktualisiert. GNOME Shell wird neu geladen"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Erweiterungen wurden aktualisiert. Bitte laden Sie die GNOME Shell neu"

#: src/api/index.ts:51
#, javascript-format
msgid "Settings successfully saved to %s"
msgstr "Einstellungen wurden erfolgreich auf %s gespeichert"

#: src/api/index.ts:54
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Beim Speichern der Einstellungen auf %s ist ein Fehler aufgetreten. Bitte prüfen Sie die Protokolle."

#: src/api/index.ts:67
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Beim Lesen der Einstellungen von %s ist ein Fehler aufgetreten. Bitte prüfen Sie die Protokolle."
