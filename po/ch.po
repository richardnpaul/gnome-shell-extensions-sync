msgstr "Ma såtba maulek i inayek siha gi %s"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Guaha linache gi sinatban inayek gi %s. Pot fabot ina i logs."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Guaha linache gi tinaitain inayek ginnen %s. Pot fabot ina i logs."

