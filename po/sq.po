#: src/prefs/prefs.ts:21
msgid "Sync Provider"
msgstr "Ofruezi i sinkronizimit"

#: src/prefs/prefs.ts:22
msgid "Select the cloud or local service to sync your settings with."
msgstr "Zgjidhni shërbimin në re ose lokal për të sinkronizuar cilësimet."

#: src/prefs/prefs.ts:30
msgid "GitHub"
msgstr "GitHub"

#: src/prefs/prefs.ts:30
msgid "GitLab"
