msgstr "Unda kijisehemu cha faragha kwenye gitlab.com na uzalishe tokeni ya ufikiaji."

#: src/prefs/prefs.ts:70
msgid "Snippet ID"
msgstr "Kitambulisho cha Kijisehemu"

#: src/prefs/prefs.ts:79
msgid "GitLab Token"
msgstr "Tokeni ya GitLab"

#: src/prefs/prefs.ts:90
msgid "Local Backup Settings"
msgstr "Mipangilio ya Nakala rudufu ya Ndani"

#: src/prefs/prefs.ts:91
msgid "Save and restore your configuration to/from a local JSON file."
msgstr "Hifadhi na urejeshe usanidi wako kwenye/kutoka faili ya ndani ya JSON."

#: src/prefs/prefs.ts:96
msgid "Backup File Location"
msgstr "Mahali pa Faili ya Nakala rudufu"

#: src/prefs/prefs.ts:97
msgid "No file selected"
msgstr "Hakuna faili iliyochaguliwa"

#: src/prefs/prefs.ts:101
msgid "Browse…"
msgstr "Vinjari…"

#: src/prefs/prefs.ts:107
msgid "Select Backup File Location"
msgstr "Chagua Mahali pa Faili ya Nakala rudufu"

#: src/prefs/prefs.ts:111
msgid "JSON files (*.json)"
msgstr "JSON files (*.json)"

#: src/prefs/prefs.ts:157
msgid "Synced Data"
msgstr "Data Iliyosawazishwa"

#: src/prefs/prefs.ts:162
msgid "Synchronized Components"
msgstr "Vipengele Vilivyosawazishwa"

#: src/prefs/prefs.ts:163
msgid "Choose which components will be uploaded and downloaded."
msgstr "Chagua vipengele vitakavyopakiwa na kupakuliwa."

#: src/prefs/prefs.ts:169
msgid "Extensions"
msgstr "Viendelezi"

#: src/prefs/prefs.ts:170
msgid "Sync all user extensions and their dconf configurations"
msgstr "Sawazisha viendelezi vyote vya mtumiaji na usanidi wao wa dconf"

#: src/prefs/prefs.ts:174
msgid "Keybindings"
msgstr "Mikato ya Kibodi"

#: src/prefs/prefs.ts:175
msgid "Sync all GNOME Shell and GTK window/media keybindings"
msgstr "Sawazisha mikato yote ya GNOME Shell na GTK"

#: src/prefs/prefs.ts:179
msgid "Tweaks"
msgstr "Marekebisho"

#: src/prefs/prefs.ts:180
msgid "Sync GNOME desktop theme, font, interface and tweak settings"
msgstr "Sawazisha mandhari ya eneo-kazi la GNOME, fonti, kiolesura na marekebisho"

#: src/prefs/prefs.ts:212
msgid "General"
msgstr "Jumla"

#: src/prefs/prefs.ts:217
msgid "Behavior and Interface"
msgstr "Tabia na Kiolesura"

#: src/prefs/prefs.ts:221
msgid "Show Tray Icon"
msgstr "Onyesha Ikoni ya Trei"

#: src/prefs/prefs.ts:222
msgid "Display the sync status icon in the top panel"
msgstr "Onyesha ikoni ya hali ya usawazishaji kwenye paneli ya juu"

#: src/prefs/prefs.ts:228
msgid "Show Notifications"
msgstr "Onyesha Arifa"

#: src/prefs/prefs.ts:229
msgid "Display desktop notifications on sync progress and errors"
msgstr "Onyesha arifa za eneo-kazi kuhusu maendeleo na makosa"

#: src/sync/index.ts:42
msgid "Failed to apply sync data to current system."
msgstr "Imeshindwa kutumia data ya usawazishaji kwenye mfumo wa sasa."

#: src/sync/index.ts:47
msgid "Extensions are updated. Reloading Gnome Shell"
msgstr "Viendelezi vimesasishwa. Inapakia upya GNOME Shell"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Viendelezi vimesasishwa. Tafadhali pakia upya GNOME Shell"

#: src/api/index.ts:47
msgid "Could not save"
msgstr "Could not save"

#: src/api/index.ts:51
#, javascript-format
msgid "Settings successfully saved to %s"
msgstr "Mipangilio imehifadhiwa kwa ufanisi katika %s"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Hitilafu ilitokea wakati wa kuhifadhi mipangilio katika %s. Tafadhali kagua kumbukumbu."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Hitilafu ilitokea wakati wa kusoma mipangilio kutoka %s. Tafadhali kagua kumbukumbu."

