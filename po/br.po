msgid "Extensions are updated. Reloading Gnome Shell"
msgstr "Hizivaet eo an astennoù. Oc'h adkargañ GNOME Shell"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Hizivaet eo an astennoù. Adkargit GNOME Shell mar plij"

#: src/api/index.ts:47
msgid "Could not save"
msgstr "Could not save"

#: src/api/index.ts:51
#, javascript-format
msgid "Settings successfully saved to %s"
msgstr "Enrollet eo bet an arventennoù e %s"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Ur fazi zo c'hoarvezet en ur enrollañ an arventennoù e %s. Gwiriit an deizlevrioù mar plij."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Ur fazi zo c'hoarvezet en ur lenn an arventennoù adalek %s. Gwiriit an deizlevrioù mar plij."

