msgid "Extensions"
msgstr "Astennoù"

#: src/prefs/prefs.ts:170
msgid "Sync all user extensions and their dconf configurations"
msgstr "Gobarzhañ holl astennoù an implijer hag o c'hefluniadur dconf"

