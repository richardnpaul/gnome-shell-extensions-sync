#: src/prefs/prefs.ts:21
msgid "Sync Provider"
msgstr "Mea Hāʻawi Hoʻopili"

#: src/prefs/prefs.ts:22
msgid "Select the cloud or local service to sync your settings with."
msgstr "E koho i ke ao a i ʻole ka lawelawe kūloko e hoʻopili ai i kāu mau hoʻonohonoho."

#: src/prefs/prefs.ts:30
msgid "GitHub"
