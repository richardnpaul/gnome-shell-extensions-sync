#: src/prefs/prefs.ts:42
msgid "GitHub Settings"
msgstr "Nā Hoʻonohonoho GitHub"

#: src/prefs/prefs.ts:43
msgid "Create a secret Gist on gist.github.com and generate a personal access token."
msgstr "E hana i kahi Gist malu ma gist.github.com a hana i hōʻailona komo ponoʻī."

#: src/prefs/prefs.ts:46
msgid "Gist ID"
msgstr "ID o ka Gist"

#: src/prefs/prefs.ts:55
msgid "GitHub Token"
msgstr "Hōʻailona GitHub"

#: src/prefs/prefs.ts:66
msgid "GitLab Settings"
msgstr "Nā Hoʻonohonoho GitLab"

#: src/prefs/prefs.ts:67
msgid "Create a private snippet on gitlab.com and generate an access token."
msgstr "E hana i snippet pilikino ma gitlab.com a hana i hōʻailona komo."

#: src/prefs/prefs.ts:70
msgid "Snippet ID"
msgstr "ID o ka Snippet"

#: src/prefs/prefs.ts:79
msgid "GitLab Token"
msgstr "Hōʻailona GitLab"

#: src/prefs/prefs.ts:90
msgid "Local Backup Settings"
msgstr "Nā Hoʻonohonoho Kākoʻo Kūloko"

#: src/prefs/prefs.ts:91
msgid "Save and restore your configuration to/from a local JSON file."
msgstr "Mālama a hoʻihoʻi i kāu hoʻonohonoho i/mai kekahi waihona JSON kūloko."

#: src/prefs/prefs.ts:96
msgid "Backup File Location"
msgstr "Kahi o ka Waihona Kākoʻo"

#: src/prefs/prefs.ts:97
msgid "No file selected"
msgstr "ʻAʻohe waihona i koho ʻia"

#: src/prefs/prefs.ts:101
msgid "Browse…"
msgstr "Huli…"

#: src/prefs/prefs.ts:107
msgid "Select Backup File Location"
msgstr "E koho i kahi o ka waihona kākoʻo"

#: src/prefs/prefs.ts:111
msgid "JSON files (*.json)"
msgstr "JSON files (*.json)"

#: src/prefs/prefs.ts:157
msgid "Synced Data"
msgstr "ʻIkepili i Hoʻopili ʻia"

#: src/prefs/prefs.ts:162
msgid "Synchronized Components"
msgstr "Nā Māhele i Hoʻopili ʻia"

#: src/prefs/prefs.ts:163
msgid "Choose which components will be uploaded and downloaded."
msgstr "E koho i nā māhele e hoʻouka a hoʻoiho ʻia."

#: src/prefs/prefs.ts:169
msgid "Extensions"
msgstr "Nā Pākuʻina"

#: src/prefs/prefs.ts:170
msgid "Sync all user extensions and their dconf configurations"
msgstr "Hoʻopili i nā pākuʻina a pau a me kā lākou hoʻonohonoho dconf"

#: src/prefs/prefs.ts:174
msgid "Keybindings"
msgstr "Nā Pihi Pōkole"

#: src/prefs/prefs.ts:175
msgid "Sync all GNOME Shell and GTK window/media keybindings"
msgstr "Hoʻopili i nā pihi pōkole a pau o GNOME Shell a me GTK"

#: src/prefs/prefs.ts:179
msgid "Tweaks"
msgstr "Nā Hoʻopololei"

#: src/prefs/prefs.ts:180
msgid "Sync GNOME desktop theme, font, interface and tweak settings"
msgstr "Hoʻopili i ke kumu, hua paʻi, a me nā hoʻopololei o GNOME"

#: src/prefs/prefs.ts:212
msgid "General"
msgstr "Laulā"

#: src/prefs/prefs.ts:217
msgid "Behavior and Interface"
msgstr "Hāmeʻa a me ka Hoʻohana"

#: src/prefs/prefs.ts:221
msgid "Show Tray Icon"
msgstr "Hōʻike i ka Hōʻailona Pahu"

#: src/prefs/prefs.ts:222
msgid "Display the sync status icon in the top panel"
msgstr "Hōʻike i ka hōʻailona kūlana hoʻopili ma ka papa luna"

#: src/prefs/prefs.ts:228
msgid "Show Notifications"
msgstr "Hōʻike i nā Hoʻolaha"

#: src/prefs/prefs.ts:229
msgid "Display desktop notifications on sync progress and errors"
msgstr "Hōʻike i nā hoʻolaha ma ka papa hana no ka holomua a me nā hewa"

#: src/sync/index.ts:42
msgid "Failed to apply sync data to current system."
msgstr "Ua hāʻule ka hoʻopili ʻana i ka ʻikepili i kēia ʻōnaehana."

#: src/sync/index.ts:47
msgid "Extensions are updated. Reloading Gnome Shell"
msgstr "Ua hōʻano hou ʻia nā pākuʻina. Ke hoʻouka hou nei iā GNOME Shell"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Ua hōʻano hou ʻia nā pākuʻina. E ʻoluʻolu e hoʻouka hou iā GNOME Shell"

#: src/api/index.ts:47
msgid "Could not save"
msgstr "Could not save"

#: src/api/index.ts:51
#, javascript-format
msgid "Settings successfully saved to %s"
msgstr "Ua mālama pono ʻia nā hoʻonohonoho i %s"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Ua loaʻa ka hewa i ka mālama ʻana i nā hoʻonohonoho i %s. E ʻoluʻolu e nānā i nā moʻolelo."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Ua loaʻa ka hewa i ka heluhelu ʻana mai %s. E ʻoluʻolu e nānā i nā moʻolelo."

#: src/api/providers/github.ts:50 src/api/providers/gitlab.ts:39
#, javascript-format
msgid "failed to save data to %s. Server status: %s"
msgstr "failed to save data to %s. Server status: %s"

#: src/api/providers/github.ts:69 src/api/providers/gitlab.ts:58
#, javascript-format
msgid "failed to read data from %s. Server status: %s"
msgstr "failed to read data from %s. Server status: %s"

#: src/api/providers/github.ts:74 src/api/providers/gitlab.ts:63
#, javascript-format
msgid "failed to read data from %s. Empty response"
msgstr "failed to read data from %s. Empty response"

#: src/api/providers/local.ts:16
msgid "Please select a backup file location from preferences"
msgstr "Please select a backup file location from preferences"

#: src/api/providers/local.ts:20
#, javascript-format
msgid "Failed to backup settings. %s does not exist"
msgstr "Failed to backup settings. %s does not exist"

#: src/api/providers/local.ts:31
#, javascript-format
msgid "Failed to read settings from backup. %s does not exist"
msgstr "Failed to read settings from backup. %s does not exist"

#: src/api/providers/local.ts:38
#, javascript-format
msgid "Failed to read settings from backup. %s could not be read"
msgstr "Failed to read settings from backup. %s could not be read"

#: src/api/providers/local.ts:42
#, javascript-format
msgid "Failed to read settings from backup. %s is corrupted"
msgstr "Failed to read settings from backup. %s is corrupted"

