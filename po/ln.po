msgstr "Mabongisi ebombami malamu na %s"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Libunga esalemi tango ya kobomba mabongisi na %s. Tala mikanda ya bilembo."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Libunga esalemi tango ya kotanga mabongisi na %s. Tala mikanda ya bilembo."

