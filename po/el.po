msgid "Extensions"
msgstr "Επεκτάσεις"

#: src/prefs/prefs.ts:170
msgid "Sync all user extensions and their dconf configurations"
msgstr "Συγχρονισμός όλων των επεκτάσεων χρήστη και των ρυθμίσεων dconf"

