msgstr "Συγχρονισμός θέματος, γραμματοσειράς και ρυθμίσεων GNOME"

#: src/prefs/prefs.ts:212
msgid "General"
msgstr "Γενικά"

#: src/prefs/prefs.ts:217
msgid "Behavior and Interface"
msgstr "Συμπεριφορά και διεπαφή"

#: src/prefs/prefs.ts:221
msgid "Show Tray Icon"
msgstr "Εμφάνιση εικονιδίου στην περιοχή ειδοποιήσεων"

#: src/prefs/prefs.ts:222
msgid "Display the sync status icon in the top panel"
msgstr "Εμφάνιση του εικονιδίου κατάστασης συγχρονισμού στον επάνω πίνακα"

#: src/prefs/prefs.ts:228
msgid "Show Notifications"
msgstr "Εμφάνιση ειδοποιήσεων"

#: src/prefs/prefs.ts:229
msgid "Display desktop notifications on sync progress and errors"
msgstr "Εμφάνιση ειδοποιήσεων επιφάνειας εργασίας για πρόοδο και σφάλματα"

#: src/sync/index.ts:42
msgid "Failed to apply sync data to current system."
msgstr "Αποτυχία εφαρμογής των δεδομένων συγχρονισμού στο τρέχον σύστημα."

#: src/sync/index.ts:47
msgid "Extensions are updated. Reloading Gnome Shell"
msgstr "Οι επεκτάσεις ενημερώθηκαν. Γίνεται επαναφόρτωση του GNOME Shell"

#: src/sync/index.ts:49
msgid "Extensions are updated. Please reload Gnome Shell"
msgstr "Οι επεκτάσεις ενημερώθηκαν. Παρακαλούμε επαναφορτώστε το GNOME Shell"

#: src/api/index.ts:47
msgid "Could not save"
msgstr "Could not save"

#: src/api/index.ts:51
#, javascript-format
msgid "Settings successfully saved to %s"
msgstr "Οι ρυθμίσεις αποθηκεύτηκαν επιτυχώς στο %s"

#: src/api/index.ts:55
#, javascript-format
msgid "Error occured while saving settings to %s. Please check the logs."
msgstr "Παρουσιάστηκε σφάλμα κατά την αποθήκευση των ρυθμίσεων στο %s. Ελέγξτε τα αρχεία καταγραφής."

#: src/api/index.ts:70
#, javascript-format
msgid "Error occured while reading settings from %s. Please check the logs."
msgstr "Παρουσιάστηκε σφάλμα κατά την ανάγνωση των ρυθμίσεων από το %s. Ελέγξτε τα αρχεία καταγραφής."

